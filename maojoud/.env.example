# قاعدة البيانات (SQLite للتطوير — يمكن التحويل إلى PostgreSQL بتغيير provider في prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# مفتاح توقيع الجلسات (32 حرفًا على الأقل) — أنشئه بـ: openssl rand -base64 48
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# الرابط العام للموقع (يُستخدم في callback_url لبوابة الدفع)
APP_URL="http://localhost:3000"

# مسار لوحة التحكم المخفي — لا يوجد أي رابط له داخل المنصة. اختر قيمة يصعب تخمينها.
ADMIN_PATH="control-7f3a9c"

# حساب المسؤول الأول (يُنشأ عند تشغيل npm run db:seed وكلمة المرور تُخزَّن مشفرة bcrypt)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-this-strong-password"

# Authentica — رمز التحقق عبر SMS  https://portal.authentica.sa/settings/apikeys/
# إذا تُرك فارغًا في بيئة التطوير يُطبع الرمز في سجل الخادم بدل إرساله.
AUTHENTICA_API_KEY=""
AUTHENTICA_TEMPLATE_ID="1"
# عدد أرقام رمز التحقق حسب قالب Authentica
NEXT_PUBLIC_OTP_LENGTH="4"

# Moyasar — بوابة الدفع  https://dashboard.moyasar.com
# إذا تُركت فارغة في بيئة التطوير يظهر زر "دفع تجريبي" بدل نموذج ميسر.
NEXT_PUBLIC_MOYASAR_PUBLISHABLE_KEY=""
MOYASAR_SECRET_KEY=""
MOYASAR_WEBHOOK_SECRET=""
