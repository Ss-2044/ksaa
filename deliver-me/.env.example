NEXT_PUBLIC_PARTNERS_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
# International format, digits only: 9665XXXXXXXX
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_ADDRESS_STREET=
NEXT_PUBLIC_ADDRESS_CITY=
NEXT_PUBLIC_ADDRESS_POSTAL_CODE=

# ---- Social ----
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_TIKTOK=
NEXT_PUBLIC_SOCIAL_X=

# ---- App ----
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_GOOGLE_PLAY_URL=
# When set, nav CTA becomes "Order Now"
NEXT_PUBLIC_WEB_ORDERING_URL=

# ---- Analytics (consent banner appears only when set) ----
NEXT_PUBLIC_GTM_ID=

# ---- Content ----
# local | sanity
CMS_PROVIDER=local
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_READ_TOKEN=
# Shows badged sample content for design review. NEVER true in production.
NEXT_PUBLIC_CONTENT_PREVIEW=false

# ---- CRM (server-only) ----
# log | hubspot | pipedrive | webhook
CRM_PROVIDER=log
HUBSPOT_ACCESS_TOKEN=
PIPEDRIVE_API_TOKEN=
PIPEDRIVE_COMPANY_DOMAIN=
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=
