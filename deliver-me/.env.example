# ---- Site ----
NEXT_PUBLIC_SITE_URL=https://deliverme.sa
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_CR_NUMBER=

# ---- Contact (leave empty to hide) ----
