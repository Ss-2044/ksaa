{
  "name": "neo-capta-video",
  "version": "1.0.0",
  "description": "Neo Capta 30s brand video (Remotion)",
  "scripts": {
    "studio": "remotion studio",
    "render": "npm run render:ar && npm run render:en",
    "typecheck": "tsc --noEmit",
    "render:ar": "remotion render NeoCaptaAR out/neo-capta-ar.mp4",
    "render:en": "remotion render NeoCaptaEN out/neo-capta-en.mp4",
    "render:lens": "remotion render NeoCaptaLensAR out/neo-capta-lens-ar.mp4 && remotion render NeoCaptaLensEN out/neo-capta-lens-en.mp4"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@remotion/cli": "^4.0.529",
    "@remotion/fonts": "^4.0.529",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.529"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "private": true
}
