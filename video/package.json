{
  "name": "neocapta-promo-video",
  "private": true,
  "scripts": {
    "studio": "remotion studio",
    "music": "node scripts/make-journey-music.mjs",
    "render": "remotion render src/index.ts Journey out/neocapta-journey.mp4",
    "music:passport": "node scripts/make-passport-music.mjs",
    "render:passport": "remotion render src/index.ts Passport out/neocapta-passport.mp4",
    "music:chess": "node scripts/make-chess-music.mjs",
    "render:chess": "remotion render src/index.ts Chess out/neocapta-chess.mp4",
    "music:blueprint": "node scripts/make-blueprint-music.mjs",
    "render:blueprint": "remotion render src/index.ts Blueprint out/neocapta-blueprint.mp4",
    "music:games": "node scripts/make-games-music.mjs",
    "render:kaboot": "remotion render src/index.ts Kaboot out/neocapta-kaboot.mp4",
    "render:rubik": "remotion render src/index.ts Rubik out/neocapta-rubik.mp4",
    "render:football": "remotion render src/index.ts Football out/neocapta-football.mp4",
    "render:domino": "remotion render src/index.ts Domino out/neocapta-domino.mp4",
    "render:vault": "remotion render src/index.ts Vault out/neocapta-vault.mp4",
    "render:chess-series": "remotion render src/index.ts ChessEp1 out/neocapta-chess-ep1.mp4 && remotion render src/index.ts ChessEp2 out/neocapta-chess-ep2.mp4 && remotion render src/index.ts ChessEp3 out/neocapta-chess-ep3.mp4",
    "render:promo": "remotion render src/index.ts Promo out/neocapta-promo.mp4 --muted",
    "render:ai": "remotion render src/index.ts AIPromo out/neocapta-ai-promo.mp4 --muted",
    "magazine": "remotion still src/index.ts MagazineCover ai-kit/magazine-cover.png && remotion still src/index.ts MagazineSpread ai-kit/magazine-spread.png --frame=59",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@fontsource/aref-ruqaa": "^5.3.0",
    "@fontsource/cairo": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@remotion/cli": "^4.0.530",
    "@remotion/google-fonts": "^4.0.530",
    "@remotion/media-utils": "^4.0.530",
    "@remotion/paths": "^4.0.530",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.530"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
